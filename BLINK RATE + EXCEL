# =============================
# Extended eye landmark indices for better EAR calculation
left_eye_indices = [33, 160, 158, 133, 153, 144, 163, 7, 
                    246, 161, 160, 159, 158, 157, 173, 133, 
                    155, 154, 153, 145, 144, 163, 7]
right_eye_indices = [362, 385, 387, 263, 373, 380, 373, 373,
                    466, 388, 387, 386, 385, 384, 398, 263,
                    249, 390, 373, 374, 380, 381, 382]

# Pupil landmark indices (iris landmarks)
left_pupil_indices = [468, 469, 470, 471, 472]
right_pupil_indices = [473, 474, 475, 476, 477]

# Mouth landmark indices for yawn detection
mouth_indices = [61, 146, 91, 181, 84, 17, 314, 405, 321, 375, 
                 291, 308, 324, 318, 402, 317, 14, 87, 178, 88, 95]

# Eye contours (for drawing)
LEFT_EYE_CONTOUR = [33, 160, 158, 133, 153, 144]
RIGHT_EYE_CONTOUR = [362, 385, 387, 263, 373, 380]

# Mouth
UPPER_LIP = 13
LOWER_LIP = 14
LEFT_MOUTH_CORNER = 61
RIGHT_MOUTH_CORNER = 291

# =============================
# Helper functions
# =============================

def draw_points(frame, landmarks, indices, w, h, color, radius=2):
    for i in indices:
        x = int(landmarks[i].x * w)
        y = int(landmarks[i].y * h)
        cv2.circle(frame, (x, y), radius, color, -1)

def overlay_logo(frame, logo):
    h, w = frame.shape[:2]
    lh, lw = logo.shape[:2]
    x_offset = w - lw - 10
    y_offset = h - lh - 10

    if logo.shape[2] == 4:  # RGBA logo
        alpha = logo[:, :, 3] / 255.0
        for c in range(3):
            frame[y_offset:y_offset+lh, x_offset:x_offset+lw, c] = (
                alpha * logo[:, :, c] +
                (1 - alpha) * frame[y_offset:y_offset+lh, x_offset:x_offset+lw, c]
            )
    else:
        frame[y_offset:y_offset+lh, x_offset:x_offset+lw] = logo

def export_to_excel(minute_blink_counts, filename):
    """Export blink data to Excel with time increments and blink counts"""
    # Calculate average blink rate
    avg_blink_rate = np.mean(list(minute_blink_counts))
    
    # Create data for DataFrame
    data = {
        'Time (minutes)': list(range(1, len(minute_blink_counts) + 1)),
        'Blinks per Minute': list(minute_blink_counts),
        'Average Blink Rate': [avg_blink_rate if i == 0 else '' for i in range(len(minute_blink_counts))]
    }
    
    # Create DataFrame
    df = pd.DataFrame(data)
    
    # Define color fills
    red_fill = PatternFill(start_color='FF0000', end_color='FF0000', fill_type='solid')
    orange_fill = PatternFill(start_color='FFA500', end_color='FFA500', fill_type='solid')
    
    # Export to Excel
    with pd.ExcelWriter(filename, engine='openpyxl') as writer:
        df.to_excel(writer, sheet_name='Blink Data', index=False)
        
        # Get workbook and worksheet for formatting
        workbook = writer.book
        worksheet = writer.sheets['Blink Data']
        
        # Auto-adjust column widths
        for column in worksheet.columns:
            max_length = 0
            column_letter = column[0].column_letter
            for cell in column:
                try:
                    if len(str(cell.value)) > max_length:
                        max_length = len(str(cell.value))
                except:
                    pass
            adjusted_width = (max_length + 2)
            worksheet.column_dimensions[column_letter].width = adjusted_width
        
        # Apply conditional formatting to "Blinks per Minute" column
        for row in range(2, len(minute_blink_counts) + 2):  # Start from row 2 (after header)
            cell = worksheet.cell(row=row, column=2)  # Column B (Blinks per Minute)
            blink_value = cell.value
            
            if blink_value is not None:
                if blink_value > 17:
                    cell.fill = red_fill
                elif blink_value < 14:
                    cell.fill = orange_fill
        
        # Create line chart
        from openpyxl.chart import LineChart, Reference
        
        chart = LineChart()
        chart.title = "Blinks per Minute Trend"
        chart.style = 13
        chart.y_axis.title = "Blinks"
        chart.x_axis.title = "Minutes"
        
        # Define data range for the chart
        data_ref = Reference(worksheet, min_col=2, min_row=1, max_row=len(minute_blink_counts) + 1)
                                                                #max_row=worksheet.max_row) 
        categories_ref = Reference(worksheet, min_col=1, min_row=2, max_row=len(minute_blink_counts) + 1)
                                                                     #max_row=worksheet.max_row) 
                                   
        
        #max_row=ws.max_row)
       
        chart.add_data(data_ref, titles_from_data=True)
        chart.set_categories(categories_ref)

        # Enable markers on the line
        series = chart.series[0]
        series.marker.symbol = "circle"
        series.marker.size = 7
        series.graphicalProperties.line.solidFill = "4472C4"  # Blue line
        series.graphicalProperties.line.width = 30
        
        # Position the chart
        worksheet.add_chart(chart, "F2")

    
    
    print(f"\n✓ Data exported successfully to: {filename}")
    
    return df

