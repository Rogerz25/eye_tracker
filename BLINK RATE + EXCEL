        logo,
        (int(logo.shape[1] * scale), LOGO_HEIGHT)
    )

def calculate_ear(landmarks, eye_indices):
    """Calculate Eye Aspect Ratio (EAR) for blink detection"""
    eye_points = []
    for idx in eye_indices:
        eye_points.append([
            landmarks[idx].x,
            landmarks[idx].y
        ])
    
    eye_points = np.array(eye_points, dtype=np.float32)
    
    # Calculate vertical distances
    vertical_dist_1 = np.linalg.norm(eye_points[1] - eye_points[5])
    vertical_dist_2 = np.linalg.norm(eye_points[2] - eye_points[4])
    
    # Calculate horizontal distance
    horizontal_dist = np.linalg.norm(eye_points[0] - eye_points[3])
    
    if horizontal_dist == 0:
        return 0
    
    ear = (vertical_dist_1 + vertical_dist_2) / (2.0 * horizontal_dist)
    return ear

def calculate_mar(landmarks):
    """Calculate Mouth Aspect Ratio (MAR) for yawn detection"""
    mouth_points = []
    for idx in mouth_indices:
        mouth_points.append([
            landmarks[idx].x,
            landmarks[idx].y
        ])
    
    mouth_points = np.array(mouth_points, dtype=np.float32)
    
    # Calculate vertical distance
    upper_lip = np.mean(mouth_points[0:10], axis=0)
    lower_lip = np.mean(mouth_points[10:20], axis=0)
    vertical_dist = np.linalg.norm(upper_lip - lower_lip)
    
    # Calculate horizontal distance
    left_corner = mouth_points[0]
    right_corner = mouth_points[6]
    horizontal_dist = np.linalg.norm(left_corner - right_corner)
    
    if horizontal_dist == 0:
        return 0
    
    mar = vertical_dist / horizontal_dist
    return mar

# =============================
# State variables
# =============================
blink_count = 0
yawn_count = 0
frame_count = 0
consecutive_closed_frames = 0
consecutive_yawn_frames = 0
total_closed_frames = 0
total_open_frames = 0
eye_state = "OPEN"

# Blink per minute tracking
blink_history = deque(maxlen=60)
minute_blink_counts = deque(maxlen=10)
last_minute_blink_count = 0
minute_start_time = time.time()

last_frame_time = time.time()
show_mesh = True

# =============================
# Camera
# =============================
cap = cv2.VideoCapture(0)
print("MORPHEUS: Eye & Mouth Fatigue Tracker")
print("ESC = exit | M = toggle face mesh | S = stop and show stats")

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    h, w = frame.shape[:2]

    now = time.time()
    dt = now - last_frame_time
    last_frame_time = now

    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = face_mesh.process(rgb)

    if results.multi_face_landmarks:
        face = results.multi_face_landmarks[0].landmark

        # =============================
        # Eye Aspect Ratio (EAR) calculation
        # =============================
        left_ear = calculate_ear(face, left_eye_indices)
        right_ear = calculate_ear(face, right_eye_indices)
        avg_ear = (left_ear + right_ear) / 2.0

        # =============================
        # Blink detection using EAR
        # =============================
        if avg_ear < EAR_THRESHOLD:
            consecutive_closed_frames += 1
            total_closed_frames += 1
            eye_state = "CLOSED"
        else:
            if consecutive_closed_frames >= BLINK_FRAME_THRESHOLD:
                blink_count += 1
                # Add blink to history with timestamp
                current_time = time.time()
                blink_history.append(current_time)
            
            consecutive_closed_frames = 0
            total_open_frames += 1
            eye_state = "OPEN"

        # =============================
        # Mouth Aspect Ratio (MAR) calculation
        # =============================
        mar = calculate_mar(face)

        # =============================
        # Yawn detection using MAR
        # =============================
        if mar > YAWN_THRESHOLD:
            consecutive_yawn_frames += 1
        else:
            if consecutive_yawn_frames >= YAWN_FRAME_THRESHOLD:
                yawn_count += 1
            
            consecutive_yawn_frames = 0

        # =============================
        # Update blink per minute statistics
        # =============================
        if now - minute_start_time >= 60:
            # Remove blinks older than 60 seconds
            while blink_history and now - blink_history[0] > 60:
                blink_history.popleft()
            
            minute_blinks = len(blink_history)
            minute_blink_counts.append(minute_blinks)
            minute_start_time = now
            
            print(f"\n{'='*60}")
            print(f"Minute {len(minute_blink_counts)}: {minute_blinks} blinks")
            print(f"{'='*60}\n")

        # =============================
        # Draw face mesh
        # =============================
        if show_mesh:
            mp_drawing.draw_landmarks(
                frame,
                results.multi_face_landmarks[0],
                mp_face_mesh.FACEMESH_TESSELATION,
                landmark_drawing_spec=None,
                connection_drawing_spec=
                mp_drawing_styles.get_default_face_mesh_tesselation_style()
            )

        # =============================
        # Draw eyes, irises, mouth
        # =============================
        draw_points(frame, face, LEFT_EYE_CONTOUR, w, h, (0, 255, 0))
        draw_points(frame, face, RIGHT_EYE_CONTOUR, w, h, (0, 255, 0))
        draw_points(frame, face, left_pupil_indices, w, h, (0, 0, 255), 2)
        draw_points(frame, face, right_pupil_indices, w, h, (0, 0, 255), 2)
        draw_points(frame, face,
                    [UPPER_LIP, LOWER_LIP, LEFT_MOUTH_CORNER, RIGHT_MOUTH_CORNER],
                    w, h, (255, 0, 0), 3)

        # =============================
        # Calculate percentages
        # =============================
        total_frames = total_open_frames + total_closed_frames
        open_pct = (total_open_frames / total_frames * 100) if total_frames > 0 else 0
        closed_pct = (total_closed_frames / total_frames * 100) if total_frames > 0 else 0

        # =============================
        # Display
        # =============================
        if logo is not None:
            overlay_logo(frame, logo)
    
        cv2.putText(frame, f"Blinks: {blink_count}", (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)

        cv2.putText(frame, f"Eyes Open: {open_pct:.1f}%", (10, 60),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)

        cv2.putText(frame, f"Eyes Closed: {closed_pct:.1f}%", (10, 90),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

        cv2.putText(frame, f"Yawns: {yawn_count}", (10, 120),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 0), 2)

        cv2.putText(frame, f"EAR: {avg_ear:.3f}", (10, 150),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)

        # Draw eye state indicator
        if eye_state == "CLOSED":
            state_text = "EYES CLOSED"
            state_color = (0, 0, 255)
        else:
            state_text = "EYES OPEN"
            state_color = (0, 255, 0)
        
        cv2.putText(frame, state_text, (w - 150, 30), 
                   cv2.FONT_HERSHEY_SIMPLEX, 0.7, state_color, 2)

    cv2.imshow("MORPHEUS: Eye & Mouth Fatigue Tracker", frame)

    key = cv2.waitKey(1) & 0xFF
    if key == 27:
        break
    elif key == ord('m'):
        show_mesh = not show_mesh
    elif key == ord('s') or key == ord('S'):
        print("\n" + "="*60)
        print("FINAL STATISTICS")
        print("="*60)
        print(f"Total Blinks: {blink_count}")
        print(f"Total Yawns: {yawn_count}")
        print(f"Time Eyes Open: {open_pct:.2f}%")
        print(f"Time Eyes Closed: {closed_pct:.2f}%")
        print(f"Total Frames: {frame_count}")
        
        print("\n" + "="*60)
        print("BLINKS PER MINUTE TABLE")
        print("="*60)
        print(f"{'Minutes':<10} {'Blinks':<15}")
        print("-"*60)
        
        for i, count in enumerate(minute_blink_counts):
            print(f"{i + 1:<10} {count:<15}")
        
        # Current minute (in progress)
        current_blinks = len(blink_history)
        print(f"{len(minute_blink_counts) + 1:<10} {current_blinks:<15} (current)")
        print("="*60)
        
        if len(minute_blink_counts) > 0:
            print(f"Average blinks/minute: {np.mean(list(minute_blink_counts)):.1f}")
        print("="*60 + "\n")
        
        # Export to Excel
        if len(minute_blink_counts) > 0:
            export_to_excel(minute_blink_counts, EXCEL_FILENAME)
        else:
            print("\nNo data to export (tracking duration less than 1 minute)")
        
        break
   
    frame_count += 1

cap.release()
cv2.destroyAllWindows()
