# Load & resize logo
# =============================
logo = cv2.imread(LOGO_PATH, cv2.IMREAD_UNCHANGED)  # RGBA
if logo is None:
    print("Warning: Logo not found. Continuing without logo.")
else:
    scale = LOGO_HEIGHT / logo.shape[0]
